{
  "openapi": "3.1.1",
  "info": {
    "title": "API Title",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/owner/login": {
      "post": {
        "tags": [
          "Owner"
        ],
        "description": "Owner authentication endpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "owner@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password123"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication",
            "headers": {
              "Set-Cookie": {
                "description": "Session cookie set on successful authentication",
                "schema": {
                  "type": "string",
                  "examples": [
                    "ACCESS_TOKEN=abc123; HttpOnly; Secure",
                    "REFRESH_TOKEN=xyz789; HttpOnly; Secure"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Authentication successful"
                }
              }
            }
          },
          "400": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureResponse"
                },
                "example": {
                  "status": "fail",
                  "message": "Invalid email or password"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/owner/logout": {
      "post": {
        "tags": [
          "Owner"
        ],
        "description": "Owner logout endpoint",
        "parameters": [
          {
            "in": "cookie",
            "name": "REFRESH_TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "REFRESH_TOKEN=xyz789; HttpOnly; Secure"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful logout",
            "headers": {
              "Set-Cookie": {
                "description": "Clears session cookies on logout",
                "schema": {
                  "type": "string",
                  "examples": [
                    "ACCESS_TOKEN=; HttpOnly; Secure; Max-Age=0",
                    "REFRESH_TOKEN=; HttpOnly; Secure; Max-Age=0"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Logout successful"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/owner/access-token": {
      "get": {
        "tags": [
          "Owner"
        ],
        "description": "Get access token for authenticated owner",
        "parameters": [
          {
            "in": "cookie",
            "name": "REFRESH_TOKEN",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "REFRESH_TOKEN=xyz789; HttpOnly; Secure"
          }
        ],
        "responses": {
          "200": {
            "description": "Access token retrieved successfully",
            "headers": {
              "Set-Cookie": {
                "description": "Access token cookie set on successful retrieval",
                "schema": {
                  "type": "string",
                  "examples": [
                    "ACCESS_TOKEN=abc123; HttpOnly; Secure"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "success",
                  "message": "Access token retrieved successfully"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "description": "Standard response for successful operations",
        "required": [
          "status",
          "message",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "default": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "additionalProperties": true,
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            ]
          }
        }
      },
      "FailureResponse": {
        "type": "object",
        "description": "Standard failure response format",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "default": "fail",
            "description": "Indicates a failure occurred"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response format",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "default": "error",
            "description": "Indicates an error occurred"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    },
    "responses": {
      "Unauthenticated": {
        "description": "Not authenticated",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/FailureResponse"
            },
            "example": {
              "status": "error",
              "message": "Not authenticated"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "example": {
              "status": "error",
              "message": "An unexpected error occurred"
            },
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  }
}